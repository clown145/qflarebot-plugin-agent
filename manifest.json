{
  "name": "agent",
  "version": "0.1.0",
  "apiVersion": 2,
  "permissions": [
    "net",
    "kv",
    "db",
    "durable",
    "proactive"
  ],
  "depends": {
    "llm": "*"
  },
  "conflicts": [],
  "commands": [
    {
      "name": "agent",
      "description": "问 Agent 一个问题",
      "usage": "/agent <问题>"
    },
    {
      "name": "agent reset",
      "description": "清空当前会话的记忆"
    },
    {
      "name": "agent schedule",
      "description": "查看本会话的定时任务",
      "usage": "/agent schedule [cancel <id>]"
    },
    {
      "name": "agent persona",
      "description": "查看或切换本会话的人格",
      "usage": "/agent persona [名字]"
    },
    {
      "name": "agent status",
      "description": "查看 Agent 状态"
    }
  ],
  "regex": [],
  "events": [
    {
      "event": [
        "qq.group.at_message"
      ]
    },
    {
      "event": [
        "qq.group.message"
      ]
    },
    {
      "event": [
        "qq.c2c.message"
      ]
    }
  ],
  "buttons": [],
  "cron": [
    {
      "name": "tick",
      "cron": "* * * * *"
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/ui/*",
      "auth": "admin"
    },
    {
      "method": "GET",
      "path": "/api/overview",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/api/persona",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/api/test",
      "auth": "admin"
    }
  ],
  "hasMiddleware": false,
  "services": [],
  "durableObjects": [
    "Agent"
  ],
  "displayName": "Agent",
  "description": "带工具调用的多轮对话：会话记忆、联网查资料、HTTP 请求、动态定时任务。需要配合「LLM 接口」插件使用。",
  "configSchema": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "title": "模型别名",
        "description": "plugin-llm 插件里配置的模型别名，默认 `chat`",
        "default": "chat"
      },
      "system_prompt": {
        "type": "string",
        "format": "textarea",
        "title": "系统提示词",
        "description": "留空则用内置的默认人格",
        "default": "你是一个运行在 QQ 上的助手。回答要简洁，能一句话说清就不要展开。\n你不确定的事情要直说，不要编造。\n你能调用工具时优先用工具拿事实，不要凭记忆猜。"
      },
      "max_model_steps": {
        "type": "integer",
        "title": "单次最多模型步数",
        "description": "一步 = 一次模型调用。失控的循环会烧光时长与 token，建议 8–12",
        "minimum": 1,
        "maximum": 30,
        "default": 8
      },
      "max_tool_calls": {
        "type": "integer",
        "title": "单次最多工具调用",
        "minimum": 1,
        "maximum": 50,
        "default": 12
      },
      "history_limit": {
        "type": "integer",
        "title": "会话历史条数",
        "description": "每次带多少条历史消息给模型。条数越多越贵",
        "minimum": 0,
        "maximum": 100,
        "default": 20
      },
      "request_timeout_ms": {
        "type": "integer",
        "title": "模型调用超时（毫秒）",
        "minimum": 1000,
        "maximum": 25000,
        "default": 20000
      },
      "enable_tools": {
        "type": "boolean",
        "title": "启用工具调用",
        "description": "关掉之后就是纯聊天，模型不会调用任何工具",
        "default": true
      },
      "enable_vfs": {
        "type": "boolean",
        "title": "启用虚拟工作区",
        "description": "模型可以读写工作区文件。小文本存 D1，超过 8KB 的存 R2（需要绑定 R2）",
        "default": false
      },
      "enable_schedule": {
        "type": "boolean",
        "title": "启用动态定时任务",
        "description": "模型可以自己创建提醒。需要机器人开启每分钟 cron",
        "default": false
      },
      "enable_audit": {
        "type": "boolean",
        "title": "记录工具调用",
        "description": "写进 D1，方便排障。会消耗 D1 写入额度",
        "default": false
      },
      "show_typing": {
        "type": "boolean",
        "title": "回复前显示\"正在输入\"",
        "description": "仅单聊有效",
        "default": true
      },
      "personas": {
        "type": "array",
        "title": "人格",
        "description": "每个会话绑一套。留空时用下面的「系统提示词」。会话里用 `/agent persona <名字>` 切换",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "title": "名字",
              "description": "会话按它绑定，建议短且唯一（如 `cat`、`assistant`）"
            },
            "prompt": {
              "type": "string",
              "format": "textarea",
              "title": "人格提示词",
              "description": "这套人格的系统提示词"
            },
            "begin_dialogs": {
              "type": "string",
              "format": "textarea",
              "title": "开场对话",
              "description": "每轮插在历史最前面，用来锚定风格。每行一句，以 `user:` / `assistant:` 开头，例如：\nuser: 你好\nassistant: 你好呀～",
              "default": ""
            }
          }
        },
        "default": []
      },
      "default_persona": {
        "type": "string",
        "title": "默认人格",
        "description": "会话没有显式绑人格时用哪一套；留空则用「系统提示词」",
        "default": ""
      },
      "wake_mode": {
        "oneOf": [
          {
            "const": "at",
            "title": "仅 @ 机器人"
          },
          {
            "const": "at_or_prefix",
            "title": "@ / 前缀 / 回复机器人"
          },
          {
            "const": "all",
            "title": "群里所有消息（需开启接收全部消息）"
          }
        ],
        "title": "群聊触发方式",
        "description": "群聊里什么消息会触发 Agent。`all` 需要群主在 QQ 里给机器人开启「接收全部消息」，否则只能收到 @ 消息",
        "default": "at"
      },
      "wake_prefix": {
        "type": "string",
        "title": "唤醒前缀",
        "description": "「@ / 前缀 / 回复机器人」模式下，以此开头的消息也会触发。默认 `/`",
        "default": "/"
      },
      "friend_needs_wake_prefix": {
        "type": "boolean",
        "title": "单聊需要前缀才触发",
        "description": "关掉时私聊任何消息都会触发 Agent；打开后私聊也要带唤醒前缀",
        "default": false
      },
      "command_prefixes": {
        "type": "string",
        "title": "机器人自身的指令前缀",
        "description": "以此开头的消息交给指令处理，不再触发 Agent。多个用逗号分隔，默认 `/`",
        "default": "/"
      },
      "timezone": {
        "type": "string",
        "title": "时区",
        "default": "Asia/Shanghai"
      }
    }
  },
  "defaultConfig": {
    "model": "chat",
    "system_prompt": "你是一个运行在 QQ 上的助手。回答要简洁，能一句话说清就不要展开。\n你不确定的事情要直说，不要编造。\n你能调用工具时优先用工具拿事实，不要凭记忆猜。",
    "personas": [],
    "default_persona": "",
    "wake_mode": "at",
    "wake_prefix": "/",
    "friend_needs_wake_prefix": false,
    "command_prefixes": "/",
    "max_model_steps": 8,
    "max_tool_calls": 12,
    "history_limit": 20,
    "request_timeout_ms": 20000,
    "enable_tools": true,
    "enable_vfs": false,
    "enable_schedule": false,
    "enable_audit": false,
    "show_typing": true,
    "timezone": "Asia/Shanghai"
  },
  "ui": {
    "path": "/ui/",
    "title": "Agent"
  }
}
